# Editorial pipeline secrets - copy this file to .env and fill in.
# .env is gitignored. NEVER commit a populated .env.

# Telegram bot for draft approvals
# Get from @BotFather (token) and the getUpdates API (chat ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API key for the Drafter / Reviewer agents
# Generated at https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# GitHub token for the bot to merge approved PRs (added when bot is built)
# Fine-grained PAT scoped to wali-07/cliniclick with contents:write + pull_requests:write
# GITHUB_TOKEN=

# Recraft API for the Visuals Agent (hero illustrations)
# Generate at https://www.recraft.ai -> API -> create token. Pay-as-you-go.
RECRAFT_API_KEY=
# Recraft model. recraftv4 = $0.04/raster image (default we use).
# V4 has no style/style_id - brand consistency comes from BRAND_STYLE_SPEC
# in agents/lib/recraft.ts plus the Image-Brand agent gate.
RECRAFT_MODEL=recraftv4
