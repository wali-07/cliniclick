# Editorial pipeline secrets - copy this file to .env and fill in.
# .env is gitignored. NEVER commit a populated .env.

# Telegram bot for draft approvals
# Get from @BotFather (token) and the getUpdates API (chat ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API key for the Drafter / Reviewer agents
# Generated at https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=

# GitHub fine-grained PAT for the editorial pipeline. Same token covers:
#  - agents/lib/github.ts (local pipeline's PR ops)
#  - agents/lib/github-storage.ts (serverless cron's commits, branch ops, merges)
# Scopes: Contents: Read & Write, Pull requests: Read & Write, on wali-07/cliniclick.
# Add to Vercel project env vars (Production + Preview) for the cron + webhook.
GITHUB_TOKEN_FOR_PR_BOT=

# Telegram approval webhook secret. Random 32+ char string, used in two places:
#  1. The webhook URL path: /api/telegram-webhook/<this-value>
#  2. Telegram's X-Telegram-Bot-Api-Secret-Token header (set via setWebhook)
# Generate once, paste here + into Vercel project env vars.
TELEGRAM_WEBHOOK_SECRET=

# Vercel cron auto-sets this when crons are provisioned. You should NOT set
# this manually in .env - it appears automatically in the function runtime
# env. Listed here for visibility.
# CRON_SECRET=(auto-generated by Vercel)

# Recraft API for the Visuals Agent (hero illustrations)
# Generate at https://www.recraft.ai -> API -> create token. Pay-as-you-go.
RECRAFT_API_KEY=
# Recraft model. recraftv4 = $0.04/raster image (default we use).
# V4 has no style/style_id - brand consistency comes from BRAND_STYLE_SPEC
# in agents/lib/recraft.ts plus the Image-Brand agent gate.
RECRAFT_MODEL=recraftv4

# Admin dashboard (admin.cliniclick.ae) - internal monitoring, login-gated.
# Set all three in Vercel (Production) too.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random long string (>=16 chars) - signs the admin session cookie.
ADMIN_SESSION_SECRET=
